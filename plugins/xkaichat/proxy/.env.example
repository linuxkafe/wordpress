# --- proxy ---
PROXY_HOST=127.0.0.1
PROXY_PORT=5001
# Chave partilhada (opcional). Se definida, o plugin envia-a no header X-Xkai-Proxy-Key.
PROXY_KEY=

# --- Ollama (rota primária) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TEMPERATURE=0.3
# Em CPU-only (sem GPU) o qwen3:8b pode demorar ~2 min por resposta.
LLM_TIMEOUT=150

# --- Gateway OpenAI-compatível (fallback OPCIONAL) ---
# GATEWAY_URL=https://api.exemplo.com/v1
# GATEWAY_API_KEY=
# GATEWAY_MODEL=gpt-4o-mini

# --- Cache ---
CACHE_DB=cache/cache.db
CACHE_TTL=86400
CACHE_SIM_THRESHOLD=0.55
CACHE_MIN_KEYWORDS=2

# --- RAG ---
KNOWLEDGE_BASE=knowledge_base.json
INDEX_DIR=index
PDFS_DIR=pdfs

# --- Rate limit (por IP) ---
RATE_LIMIT_PER_IP=20
RATE_WINDOW_SECONDS=60

# PROXY_DEBUG=1